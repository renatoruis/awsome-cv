---
const { cv } = Astro.props;
const c = cv.certifications;
---

<section class="cv-section container" id="certifications">
  <h2 class="section-title"><span class="hash">##</span>{c.title}</h2>
  <p class="section-cmd">kubectl get certs --field-selector status=Active</p>
  <div class="cert-featured">
    {c.featured.map((cert) => <div class="cert-badge">☸ {cert}</div>)}
  </div>
  <ul class="cert-others">
    {c.others.map((cert) => <li>{cert}</li>)}
  </ul>
</section>
