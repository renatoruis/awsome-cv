---
const { cv } = Astro.props;
const e = cv.education;
---

<section class="cv-section container" id="education">
  <h2 class="section-title"><span class="hash">##</span>{e.title}</h2>
  <p class="section-cmd">kubectl get education --sort-by=.metadata.creationTimestamp</p>
  <div class="cards-grid">
    {e.items.map((item, i) => (
      <div class:list={['card', { 'web-only': i >= (cv.pdf?.educationHideAfter ?? Infinity) }]}>
        <h3>{item.name}</h3>
        <p>{item.org}</p>
        <p><small>{item.period}</small></p>
      </div>
    ))}
  </div>
</section>
