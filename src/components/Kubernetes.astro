---
const { cv, ui } = Astro.props;
const k = cv.kubernetes;
const c = cv.certifications;
---

<section class="cv-section container" id="kubernetes">
  <h2 class="section-title"><span class="hash">##</span>{k.title}</h2>
  <p class="section-cmd">kubectl get certifications -l vendor=cncf</p>
  <p class="section-intro">{k.intro}</p>
  <ul class="check-list">
    {k.items.map((item) => <li>{item}</li>)}
  </ul>

  <p class="section-cmd term-only kubestronaut-cmd">kubectl get kubestronaut renatoruis -o wide</p>
  <div class="cert-kubestronaut">
    <div class="kubestronaut-line">
      <span class="cert-kubestronaut-icon classic-only" aria-hidden="true">☸</span>
      {c.kubestronaut}
    </div>
    <details class="cert-decoder">
      <summary>
        <i class="fa-regular fa-circle-question" aria-hidden="true"></i>
        {ui.decoder.prompt}
      </summary>
      <div class="cert-decoder-body">
        <p>{ui.decoder.intro}</p>
        <ul>
          {ui.decoder.items.map((item) => <li>{item}</li>)}
        </ul>
        <p class="cert-decoder-punchline">{ui.decoder.punchline}</p>
      </div>
    </details>
  </div>
</section>
