---
const { cv, ui } = Astro.props;
const locales = ['en', 'pt-pt', 'pt-br'];
const pdfHref = `/pdf/renato-ruis-cv-${cv.locale}.pdf`;
---

<header class="topbar">
  <div class="topbar-inner">
    <span class="term-only topbar-dots" aria-hidden="true">
      <span class="dot dot-r"></span>
      <span class="dot dot-y"></span>
      <span class="dot dot-g"></span>
    </span>
    <a class="brand" href={`/${cv.locale}/`}>
      <span class="classic-only"><span class="prompt-char">~$</span> renatoruis</span>
      <span class="term-only">renato@k8s:~/cv</span>
    </a>
    <div class="topbar-actions">
      <nav class="lang-switch" aria-label="Language">
        {locales.map((l) => (
          <a
            href={`/${l}/`}
            class={l === cv.locale ? 'active' : ''}
            aria-current={l === cv.locale ? 'page' : undefined}
            title={ui.langNames[l]}
            aria-label={ui.langNames[l]}
          >
            {ui.langFlags[l]}
          </a>
        ))}
      </nav>
      <span class="easter-wrap" id="easter-wrap">
        <span class="easter-callout" id="easter-callout">{ui.themeCallout}</span>
        <button
          class="btn btn-easter btn-icon"
          id="theme-toggle"
          type="button"
          title={ui.themeHint}
          aria-label={ui.themeTerminal}
          data-label-terminal={ui.themeTerminal}
          data-label-classic={ui.themeClassic}
        >
          <i class="fa-solid fa-terminal" aria-hidden="true"></i>
          <span class="btn-easter-label">{ui.themeTerminal}</span>
        </button>
      </span>
      <a
        class="btn btn-primary btn-icon btn-pdf"
        href={pdfHref}
        download
        title={ui.downloadPdf}
        aria-label={ui.downloadPdf}
      >
        <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>
        <span class="btn-pdf-label">{ui.downloadPdf}</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    const labelEl = btn.querySelector('.btn-easter-label');
    const root = document.documentElement;

    const sync = () => {
      const isTerminal = root.dataset.theme === 'terminal';
      const label = isTerminal ? btn.dataset.labelClassic : btn.dataset.labelTerminal;
      if (labelEl) labelEl.textContent = label;
      btn.setAttribute('aria-label', label);
    };

    btn.addEventListener('click', () => {
      document.body.classList.add('theme-switching');
      root.dataset.theme = root.dataset.theme === 'terminal' ? 'classic' : 'terminal';
      localStorage.setItem('cv-theme', root.dataset.theme);
      sync();
      setTimeout(() => document.body.classList.remove('theme-switching'), 300);
    });

    document.getElementById('easter-callout')?.addEventListener('click', () => btn.click());
    sync();
  })();
</script>
