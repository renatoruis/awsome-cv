---
const { cv, ui } = Astro.props;
const year = new Date().getFullYear();
const mailHref = `mailto:${cv.basics.email}?subject=${encodeURIComponent(ui.mailSubject)}&body=${encodeURIComponent(ui.mailBody)}`;
---

<footer class="site-footer">
  <div class="container">
    <p class="footer-prompt">kubectl get engineer renatoruis -o yaml | grep status → Running ☸</p>
    <a class="btn btn-primary say-hi" href={mailHref}>
      <i class="fa-regular fa-paper-plane" aria-hidden="true"></i>
      {ui.sayHi}
    </a>
    <p>
      © {year} {cv.basics.name} · {ui.footerBuilt}
      <a href="https://github.com/renatoruis/awsome-cv" target="_blank" rel="noopener"><i class="fa-brands fa-github meta-icon" aria-hidden="true"></i>{ui.footerSource}</a>
    </p>
    <p class="footer-agents">
      {ui.footerAgents}:
      <a href="/llms.txt">llms.txt</a>
      ·
      <a href={`/${cv.locale}.md`}>Markdown</a>
      ·
      <a href={`/${cv.locale}.json`}>JSON</a>
    </p>
  </div>
</footer>
